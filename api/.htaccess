Options -Indexes
AddHandler cgi-script .cgi
RewriteEngine On
RewriteRule ^frag-moritz\.php$ frag-moritz.cgi [END]
<Files "frag-moritz-core.php">
Require all denied
</Files>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
</IfModule>
